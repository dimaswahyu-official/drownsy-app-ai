{
  "expo": {
    "name": "DrowsyGuard",
    "slug": "drowsy-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": { "package": "com.yourname.drowsyguard", "permissions": ["CAMERA", "VIBRATE"] },
    "ios": { "bundleIdentifier": "com.yourname.drowsyguard" },
    "plugins": [
      ["react-native-vision-camera", { "cameraPermissionText": "DrowsyGuard uses the front camera to detect drowsiness." }]
    ]
  }
}